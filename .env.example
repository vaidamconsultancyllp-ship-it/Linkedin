# Create an app at https://www.linkedin.com/developers/apps
# Products to add: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Authorized redirect URL: http://localhost:8765/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

